<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.libraryplus.ui.AllBooksController"
      spacing="14" styleClass="main-container" prefWidth="950" prefHeight="700">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header & Search Bar -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card">
        <padding>
            <Insets top="12" right="16" bottom="12" left="16"/>
        </padding>
        <Label text="🔍" style="-fx-font-size: 16px;" />
        <TextField fx:id="filterField" promptText="Filter catalog by title, author, or category..." HBox.hgrow="ALWAYS" styleClass="search-field" />
        <Button fx:id="refreshButton" text="🔄 Refresh" styleClass="pill-button" />
        <Button fx:id="chatbotButton" text="💬 AI Assistant" onAction="#onChatbot" styleClass="button-primary" />
    </HBox>

    <!-- Metrics Bar -->
    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="card">
        <padding>
            <Insets top="10" right="16" bottom="10" left="16"/>
        </padding>
        <Label fx:id="bookCountLabel" text="📚 Total Titles: 0" styleClass="badge" />
        <Label fx:id="stockCountLabel" text="📦 Total Stock: 0" styleClass="balance-badge" />
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="card">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>
        <TilePane fx:id="coversPane" hgap="16" vgap="16" prefColumns="6" />
    </ScrollPane>

    <HBox alignment="CENTER_RIGHT">
        <Button text="✕ Close Window" onAction="#onClose" styleClass="button-secondary" />
    </HBox>
</VBox>
