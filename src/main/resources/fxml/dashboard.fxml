<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.libraryplus.ui.DashboardController"
            styleClass="dashboard-root"
            prefWidth="1100" prefHeight="720">

    <!-- Top Navigation & Actions -->
    <top>
        <VBox spacing="0">
            <!-- Top Branding & Status Header -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="header-bar">
                <Label text="📚 LibraryPlus" style="-fx-font-size: 20px; -fx-font-weight: 800;" />
                <Label fx:id="welcomeLabel" text="Welcome" styleClass="user-badge" />
                <Label fx:id="balanceLabel" text="💳 0.00 DT" styleClass="balance-badge" />
                <Button text="➕ Top Up" onAction="#onTopUpBalance" styleClass="pill-button" />
                <Button fx:id="myLoansButton" text="📑 My Loans" onAction="#onMyLoans" styleClass="pill-button" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="themeToggleButton" text="🌙 Theme" onAction="#onToggleTheme" styleClass="pill-button" />
                <Button fx:id="musicToggleButton" text="🔊" onAction="#onToggleMusic" styleClass="pill-button" />
                <Slider fx:id="volumeSlider" min="0" max="1" value="0.35" blockIncrement="0.05" prefWidth="90" />
                <Button fx:id="logoutButton" text="🚪 Sign Out" onAction="#onLogout" styleClass="button-danger" />
            </HBox>

            <!-- Search & Actions Ribbon -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="dashboard-search">
                <TextField fx:id="searchField" promptText="Search books by title, author, category, ISBN..." HBox.hgrow="ALWAYS" />
                <Button text="🔍 Search" onAction="#onSearch" styleClass="button-primary" />
                <Button fx:id="showAllButton" text="📖 All Books" onAction="#onShowAllClicked" />

                <Separator orientation="VERTICAL" style="-fx-padding: 0 4;" />

                <!-- Admin Action Buttons -->
                <Button fx:id="addBookButton" text="+ Add Book" onAction="#onAddBook" styleClass="button-success" />
                <Button fx:id="editButton" text="✎ Edit" onAction="#onEditBook" />
                <Button fx:id="deleteButton" text="🗑 Delete" onAction="#onDeleteBook" />
                <Button fx:id="usersButton" text="👥 Users" onAction="#onShowUsers" />
                <Button fx:id="statisticsButton" text="📊 Statistics" onAction="#onShowStatistics" />
                <Button fx:id="inboxButton" text="📬 Inbox" onAction="#onInbox" />
                <Button fx:id="viewSubscriptionsButton" text="📋 Subscriptions" onAction="#onViewSubscriptions" />

                <!-- Member Action Buttons -->
                <Button fx:id="chatButton" text="💬 AI Assistant" onAction="#onChat" styleClass="button-primary" />
                <Button fx:id="requestBookButton" text="📨 Request Book" onAction="#onRequestBook" />
                <Button fx:id="subscribeButton" text="⭐ Subscribe (20DT)" onAction="#onSubscribe" styleClass="button-primary" />
            </HBox>
        </VBox>
    </top>

    <!-- Main Content SplitPane -->
    <center>
        <SplitPane dividerPositions="0.60" orientation="HORIZONTAL" style="-fx-padding: 8; -fx-background-color: transparent;">

            <!-- Left: Catalog, Discovery & Search Results -->
            <VBox spacing="10" style="-fx-padding: 8; -fx-background-color: transparent;">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="pageTitle" text="Library Catalog" styleClass="page-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Discover &amp; Borrow" styleClass="page-subtitle" />
                </HBox>

                <!-- Featured Section -->
                <Label text="⭐ Featured Books" styleClass="section-title" />
                <StackPane fx:id="carouselPane" styleClass="carousel-pane" prefHeight="150">
                    <VBox alignment="CENTER" spacing="6">
                        <ImageView fx:id="carouselCover" fitHeight="110" preserveRatio="true" />
                        <Label fx:id="carouselTitle" styleClass="carousel-title" />
                    </VBox>
                </StackPane>
                <HBox fx:id="featuredBox" spacing="8" />

                <!-- Search History -->
                <Label text="🕒 Recent Searches" styleClass="section-title" />
                <ListView fx:id="searchHistoryListView" prefHeight="70" />

                <!-- Results & Categories Area -->
                <Label text="📚 Catalog Collection" styleClass="section-title" />
                <StackPane fx:id="resultsStackPane" VBox.vgrow="ALWAYS">
                    <ScrollPane fx:id="categorizedPane" fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <VBox fx:id="categoriesScrollContent" spacing="14" style="-fx-padding: 0 0 16 0; -fx-background-color: transparent;" />
                    </ScrollPane>

                    <VBox fx:id="searchResultsPane" spacing="8" visible="false">
                        <ListView fx:id="booksListView" VBox.vgrow="ALWAYS" />
                        <Button fx:id="loadMoreButton" text="Load More Books..." onAction="#onLoadMore" maxWidth="Infinity" />
                    </VBox>
                </StackPane>
            </VBox>

            <!-- Right: Interactive Book Detail Panel -->
            <ScrollPane fitToWidth="true" style="-fx-padding: 8; -fx-background-color: transparent; -fx-border-color: transparent;">
                <VBox spacing="12" style="-fx-padding: 8; -fx-background-color: transparent;" fx:id="detailPane">
                    <!-- Book Header Card -->
                    <VBox spacing="6" styleClass="card">
                        <Label fx:id="detailTitle" text="Select a book to preview" styleClass="detail-title" wrapText="true" />
                        <Label fx:id="detailAuthor" text="" styleClass="detail-author" />
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label fx:id="detailCategory" text="" styleClass="badge-category" />
                            <Label fx:id="detailStock" text="" styleClass="badge-in-stock" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailPrice" text="" styleClass="detail-price" />
                        </HBox>
                        <Label fx:id="detailIsbn" text="" styleClass="detail-meta" />
                    </VBox>

                    <!-- Detail Tabs -->
                    <TabPane fx:id="detailTabPane" tabClosingPolicy="UNAVAILABLE">
                        <tabs>
                            <!-- Tab 1: Overview -->
                            <Tab text="📖 Overview">
                                <VBox spacing="10" style="-fx-padding: 10;">
                                    <Label text="Book Summary:" style="-fx-font-weight: 700; -fx-font-size: 13px;" />
                                    <TextArea fx:id="detailDescription" editable="false" wrapText="true" prefRowCount="8" />

                                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 6 0 0 0;">
                                        <Button text="📖 Borrow (14 Days)" onAction="#onBorrow" styleClass="button-primary" />
                                        <Button text="↩️ Return Book" onAction="#onReturnBook" />
                                        <Button text="🛍️ Buy Copy" onAction="#onPurchase" styleClass="button-success" />
                                    </HBox>
                                </VBox>
                            </Tab>

                            <!-- Tab 2: Reviews & Ratings -->
                            <Tab text="💬 Reviews">
                                <VBox spacing="10" style="-fx-padding: 10;">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label fx:id="ratingSummaryLabel" text="⭐ Average Rating: N/A" style="-fx-font-weight: 700; -fx-font-size: 13px;" />
                                    </HBox>
                                    <ListView fx:id="reviewsListView" prefHeight="200" />
                                    <VBox spacing="6" style="-fx-padding: 4 0 0 0;">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="Your Rating:" style="-fx-font-weight: 600; -fx-font-size: 12px;" />
                                            <ChoiceBox fx:id="ratingChoiceBox" prefWidth="130" />
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <TextField fx:id="newReviewField" promptText="Share your thoughts about this book..." HBox.hgrow="ALWAYS" />
                                            <Button text="Submit Review" onAction="#onSubmitReview" styleClass="button-primary" />
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </Tab>

                            <!-- Tab 3: Purchase & Pricing -->
                            <Tab text="💳 Purchase &amp; Wallet">
                                <VBox spacing="12" style="-fx-padding: 12;">
                                    <Label text="Unit Price:" style="-fx-font-weight: 600;" />
                                    <TextField fx:id="unitPriceField" editable="false" promptText="Select a book" />
                                    <Label fx:id="purchaseDiscountInfo" text="💡 Subscribers automatically receive a 10% discount on purchases."
                                           wrapText="true" style="-fx-font-size: 12px; -fx-opacity: 0.85;" />
                                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0;">
                                        <Button text="💳 Buy Copy" onAction="#onPurchase"
                                                maxWidth="Infinity" prefHeight="40" styleClass="button-success" HBox.hgrow="ALWAYS" />
                                        <Button text="➕ Top Up" onAction="#onTopUpBalance"
                                                prefHeight="40" styleClass="button-primary" />
                                    </HBox>
                                </VBox>
                            </Tab>
                        </tabs>
                    </TabPane>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>
</BorderPane>
