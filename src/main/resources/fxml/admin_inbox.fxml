<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="620.0" prefWidth="850.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.libraryplus.ui.AdminInboxController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header-bar" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="14" right="20" bottom="14" left="20"/>
         </padding>
         <children>
            <Label styleClass="header-title" text="📬 Admin Messages &amp; Requests" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onRefresh" text="🔄 Refresh" styleClass="pill-button" />
         </children>
      </HBox>
   </top>
   <center>
      <SplitPane dividerPositions="0.38" prefHeight="160.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <items>
            <VBox spacing="8.0" styleClass="card">
               <padding>
                  <Insets top="12" right="12" bottom="12" left="12"/>
               </padding>
               <children>
                  <Label text="Incoming Inquiries" styleClass="section-title" />
                  <ListView fx:id="messageListView" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="card">
               <padding>
                  <Insets top="16" right="16" bottom="16" left="16"/>
               </padding>
               <children>
                  <Label text="Message Details" styleClass="section-title" />
                  <Label text="Subject:" styleClass="field-label" />
                  <TextField fx:id="subjectField" editable="false" />
                  <Label text="Sender Email:" styleClass="field-label" />
                  <TextField fx:id="senderField" editable="false" />
                  <Label text="Message Content:" styleClass="field-label" />
                  <TextArea fx:id="contentArea" editable="false" prefHeight="140.0" wrapText="true" />
                  <Label text="Admin Reply:" styleClass="field-label" />
                  <TextArea fx:id="replyArea" prefHeight="100.0" promptText="Type response to member..." wrapText="true" />
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onMarkRead" text="✓ Mark as Read" styleClass="button-secondary" />
                        <Button mnemonicParsing="false" onAction="#onSendReply" text="✉️ Send Reply" styleClass="button-primary" />
                     </children>
                  </HBox>
               </children>
            </VBox>
        </items>
      </SplitPane>
   </center>
</BorderPane>
