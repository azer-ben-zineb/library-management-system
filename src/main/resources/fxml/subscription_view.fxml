<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="620.0" prefWidth="850.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.libraryplus.ui.SubscriptionViewController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header-bar" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="14" right="20" bottom="14" left="20"/>
         </padding>
         <children>
            <Label styleClass="header-title" text="💳 Member Subscription Management" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onRefresh" text="🔄 Refresh" styleClass="pill-button" />
            <Button mnemonicParsing="false" onAction="#onClose" text="✕ Close" styleClass="button-secondary" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox spacing="10.0" styleClass="card" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="14" right="16" bottom="14" left="16"/>
         </padding>
         <children>
            <TableView fx:id="subscriptionTable" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="clientIdColumn" prefWidth="80.0" text="Client ID" />
                <TableColumn fx:id="nameColumn" prefWidth="160.0" text="Member Name" />
                <TableColumn fx:id="emailColumn" prefWidth="200.0" text="Email" />
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
                <TableColumn fx:id="startDateColumn" prefWidth="130.0" text="Start Date" />
                <TableColumn fx:id="endDateColumn" prefWidth="130.0" text="End Date" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
