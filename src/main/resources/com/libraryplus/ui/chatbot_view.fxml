<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="520.0" prefWidth="420.0" styleClass="main-container"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.libraryplus.ui.ChatbotController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="header-bar" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="12" right="16" bottom="12" left="16"/>
         </padding>
         <children>
            <Label text="🤖 LibraryPlus AI Concierge" styleClass="header-title" style="-fx-font-size: 15px;" />
         </children>
      </HBox>
   </top>
   <center>
      <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="card" vbarPolicy="AS_NEEDED" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="chatContainer" spacing="10.0">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="10.0" styleClass="card" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="12" right="12" bottom="12" left="12"/>
         </padding>
         <children>
            <TextField fx:id="inputField" onAction="#onSend" promptText="Ask about books, loans, balance, rules..." HBox.hgrow="ALWAYS" styleClass="text-field" />
            <Button mnemonicParsing="false" onAction="#onSend" styleClass="button-primary" text="Send 🚀" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
